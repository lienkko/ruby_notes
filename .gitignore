# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
/vendor/bundle/

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore test coverage and generated documentation.
/coverage/
/.yardoc/
/doc/

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore local dependency and package-manager artifacts.
/node_modules/
/.ruby-gemset
/.ruby-version.local

# Ignore local Docker Compose overrides.
/compose.override.yaml
/docker-compose.override.yml

# Ignore key files for decrypting credentials and more.
/config/*.key

# Local project explanations and instructions.
/project_instructions/

# Ignore operating-system and editor files.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
